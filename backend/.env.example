APP_NAME=ReconFlow API
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://reconflow:CHANGE_ME@localhost:5432/reconflow
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
